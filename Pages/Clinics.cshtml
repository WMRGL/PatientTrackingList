@page
@model PatientTrackingList.Pages.ClinicsModel
@{
}
<div class="container">

    @if(Model.Message != null)
    {
        @if (!Model.isSuccess)
        {
            <div class="alert alert-danger text-center">
                @Model.Message
            </div>
        }
        else
        {
            <div class="alert alert-success text-center">
                @Model.Message
            </div>
        }
    }

    <div class="card">
    <h1>Clinic data</h1>
    <form method="post">
        <div class="row mb-5 g-5">
            <div class="col-md-1">                
                <label>Seen By:</label>                
            </div>
            <div class="col-md-4">                
                <select name="clinicianCode" asp-for="seenBy">
                    <option value="" selected>...Select</option>
                    @foreach(var s in Model.staffMembers)
                    {
                        <option value=@s.STAFF_CODE>@s.NAME</option>
                    }
                </select>                
            </div>            
        </div>

        <div class="row mb-5 g-5">
            <div class="col-md-1">
                <label>From:</label>
            </div>
            <div class="col-md-2">
                <input type="date" name="startDate" asp-for="startDate" />
            </div>
            <div class="col-md-1">
                <label>To:</label>
            </div>
            <div class="col-md-2">
                <input type="date" name="endDate" asp-for="endDate" />
            </div>
        </div>

        @*<div class="row mb-5 g-5">
            <div class="col-md-1">
                <label>Diagnosis:</label>
            </div>
            <div class="col-md-2">
                <select name="diseaseCode" asp-for="disCode">
                    <option value="" selected>...Select</option>
                    @foreach (var d in Model.diseases)
                    {
                        <option value=@d.DISEASE_CODE>@d.DISEASE_CODE - @d.DESCRIPTION</option>
                    }
                </select>
            </div>

        </div>*@

        <div class="row mb-5 g-5">
            <div class="col-md-4">
                <input type="submit" class="btn btn-secondary" />
            </div>
            <div class="col-md-6"></div>
            <div class="col-md-2">
                @*<a class="btn btn-outline-primary" asp-page="PrintReport">Print Report</a>*@
                @*<input type="submit" class="btn btn-outline-primary" asp-route-isPrintReq="true" value="Print Report" />*@
                <a class="btn btn-primary btn-lg" asp-area=""
                asp-page="/Download" asp-route-clinicianFilter=@Model.seenBy
                asp-route-gcFilter=@Model.seenBy asp-route-dateFrom=@Model.startDate asp-route-dateTo=@Model.endDate
                asp-route-username=@Model.User.Identity.Name asp-route-type="clinic">Export Data</a>
            </div>
        </div>        
    </form>


    <div class="row">
        <table id="defaultTable" class="table">
            <thead>
                <tr>
                    <th>CGU Number</th>
                    <th>Patient</th>
                    <th>Type</th>
                    <th>Seen By</th>
                    <th>Location</th>    
                    <th>Outcome</th>
                    <th>Outcome Entered Date</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var a in Model.appointments)
                {
                    <tr>
                        <td>@a.CGU_No</td>
                        <td>@a.FIRSTNAME @a.LASTNAME - NHS No: @a.NHSNo</td>
                        <td>@a.AppType</td>
                        <td>@a.SeenByClinician</td>
                        <td>@a.ClinicLocation</td>
                        <td>@a.Attendance</td>
                        @if(a.OUTCOME_ENTERED.HasValue)
                        {
                            <td>@a.OUTCOME_ENTERED.Value.ToString("dd/MM/yyyy")</td>
                        }
                        else
                        {
                            <td></td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    </div>
</div>